NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Docker Compose maps Postgres to host port 5434 (see docker-compose.yml)
DATABASE_URL=postgresql://cakeconnect:cakeconnect@localhost:5434/cakeconnect

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Docker Compose maps Redis to host port 6380 (see docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

CREDIT_LIMIT_BEHAVIOR=WARN
GLOBAL_CUTOFF_TIME=22:00

CORS_ORIGIN=*
