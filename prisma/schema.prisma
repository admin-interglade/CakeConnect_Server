// CakeConnect - PostgreSQL schema
// Franchise ordering and operations platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  SHOP_OWNER
  SUPPORT_STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  UNAVAILABLE
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
  INVOICED
  CANCELLED
  NO_ORDER_PLACED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  CASH
  CHEQUE
  NEFT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PENDING_CONFIRMATION
  REJECTED
  REFUNDED
}

enum LedgerTransactionType {
  INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  ADJUSTMENT
  REFUND
}

enum LedgerReferenceType {
  INVOICE
  PAYMENT
  ORDER
  CREDIT_NOTE
  DEBIT_NOTE
  ADJUSTMENT
  REFUND
}

enum DiscountType {
  PERCENTAGE
  FLAT
  BUY_X_GET_Y
}

enum OfferStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  CUT_OFF_REMINDER
  ORDER_SUBMITTED
  ORDER_ACCEPTED
  ORDER_IN_PRODUCTION
  ORDER_DISPATCHED
  ORDER_DELIVERED
  INVOICE_GENERATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_OVERDUE
  NEW_OFFER
  CREDIT_LIMIT_WARNING
}

enum ProductionPlanStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
}

enum CutoffSource {
  GLOBAL
  SHOP
  DATE
}

// ============================================================
// USERS & AUTH
// ============================================================

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  mobileNumber String       @unique
  email        String?      @unique
  role         Role         @default(SHOP_OWNER)
  status       UserStatus   @default(ACTIVE)
  profileImage String?
  passwordHash String?
  pinHash      String?
  mustChangePassword Boolean  @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions   Session[]
  shopsOwned Shop[]        @relation("ShopOwner")
  shopUsers  ShopUser[]
  notifications Notification[]
  preferences NotificationPreference[]
  auditLogs  AuditLog[]    @relation("AuditActor")

  @@index([role])
  @@index([status])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  deviceId     String?
  fcmToken     String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OTP {
  id         String    @id @default(uuid()) @db.Uuid
  mobileNumber String
  otp        String
  verified   Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([mobileNumber])
  @@index([mobileNumber, verified])
}

// ============================================================
// SHOPS
// ============================================================

model Shop {
  id              String    @id @default(uuid()) @db.Uuid
  shopCode        String    @unique
  shopName        String
  ownerId         String?   @db.Uuid
  mobileNumber    String
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  creditLimit     Decimal   @default(0) @db.Decimal(12, 2)
  currentOutstanding Decimal @default(0) @db.Decimal(12, 2)
  creditBehavior  String    @default("WARN")
  status          ShopStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner     User?  @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  shopUsers ShopUser[]
  priceListAssociations ShopPriceList[]
  orders        Order[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  cutoffOverrides ShopCutoffSetting[]
  offerShops  OfferShop[]
  offerRegions OfferRegion[]

  @@unique([ownerId, shopCode])
  @@index([ownerId])
  @@index([status])
  @@index([shopCode])
}

model ShopUser {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  userId    String   @db.Uuid
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId])
}

// ============================================================
// CATALOGUE
// ============================================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  leadTimeHours Int?    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  sku           String    @unique
  categoryId    String    @db.Uuid
  description   String?
  imageUrl      String?
  unit          String    @default("piece")
  basePrice     Decimal   @default(0) @db.Decimal(12, 2)
  minimumOrderQuantity Int @default(1)
  packSize      Int       @default(1)
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availability ProductAvailability[]
  priceListItems PriceListItem[]
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]
  deliveryItems DeliveryItem[]
  productionPlanItems ProductionPlanItem[]
  offers       OfferProduct[]

  @@index([categoryId])
  @@index([status])
  @@index([sku])
}

model ProductAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  date      DateTime @db.Date
  available Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
}

// ============================================================
// PRICE LISTS
// ============================================================

model PriceList {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  region      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items  PriceListItem[]
  shops  ShopPriceList[]
}

model PriceListItem {
  id          String  @id @default(uuid()) @db.Uuid
  priceListId String  @db.Uuid
  productId   String  @db.Uuid
  price       Decimal @db.Decimal(12, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([productId])
}

model ShopPriceList {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  priceListId String   @db.Uuid
  assignedAt  DateTime @default(now())

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([shopId, priceListId])
  @@index([shopId])
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  orderNumber  String      @unique
  shopId       String      @db.Uuid
  deliveryDate DateTime    @db.Date
  orderDate    DateTime    @default(now())
  status       OrderStatus @default(DRAFT)
  subtotal     Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  notes        String?
  submittedAt  DateTime?
  submittedBy  String?     @db.Uuid
  locked       Boolean     @default(false)
  noOrderPlaced Boolean    @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items     OrderItem[]
  delivery  Delivery?
  invoice   Invoice?

  @@index([shopId])
  @@index([deliveryDate])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  notes       String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

// ============================================================
// CUT-OFF
// ============================================================

model CutoffSetting {
  id             String      @id @default(uuid()) @db.Uuid
  cutoffTime     String      @default("22:00")
  source         CutoffSource @default(GLOBAL)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  shopOverride ShopCutoffSetting[]
  dateOverride DateCutoffOverride[]
}

model ShopCutoffSetting {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @db.Uuid
  cutoffSettingId String  @db.Uuid
  createdAt      DateTime @default(now())

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cutoffSetting CutoffSetting  @relation(fields: [cutoffSettingId], references: [id], onDelete: Cascade)

  @@unique([shopId, cutoffSettingId])
}

model DateCutoffOverride {
  id             String   @id @default(uuid()) @db.Uuid
  date           DateTime @db.Date
  cutoffSettingId String  @db.Uuid
  createdAt      DateTime @default(now())

  cutoffSetting CutoffSetting @relation(fields: [cutoffSettingId], references: [id], onDelete: Cascade)

  @@unique([date, cutoffSettingId])
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  name      String
  isNonDeliveryDay Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([date])
}

// ============================================================
// PRODUCTION
// ============================================================

model ProductionPlan {
  id            String              @id @default(uuid()) @db.Uuid
  productionDate DateTime           @db.Date
  status        ProductionPlanStatus @default(DRAFT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items ProductionPlanItem[]

  @@unique([productionDate])
}

model ProductionPlanItem {
  id                String  @id @default(uuid()) @db.Uuid
  productionPlanId  String  @db.Uuid
  productId         String  @db.Uuid
  requiredQuantity  Int
  producedQuantity  Int     @default(0)

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productionPlanId, productId])
}

// ============================================================
// DELIVERIES
// ============================================================

model Delivery {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @unique @db.Uuid
  deliveryDate DateTime @db.Date
  status      DeliveryStatus @default(PENDING)
  dispatchedAt DateTime?
  deliveredAt DateTime?
  receivedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items DeliveryItem[]

  @@index([deliveryDate])
}

model DeliveryItem {
  id               String @id @default(uuid()) @db.Uuid
  deliveryId       String @db.Uuid
  productId        String @db.Uuid
  orderedQuantity  Int
  deliveredQuantity Int @default(0)
  shortQuantity    Int @default(0)
  shortSupplyReason String?
  notes            String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, productId])
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceNumber String       @unique
  shopId       String        @db.Uuid
  orderId      String?       @unique @db.Uuid
  invoiceDate  DateTime      @default(now()) @db.Date
  dueDate      DateTime
  subtotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal   @default(0) @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  basedOnDelivered Boolean    @default(true)
  invoicePdfPath String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  shop     Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  order    Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]
  allocations PaymentAllocation[]

  @@index([shopId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id           String  @id @default(uuid()) @db.Uuid
  invoiceId    String  @db.Uuid
  productId    String  @db.Uuid
  productName  String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                String       @id @default(uuid()) @db.Uuid
  paymentReference  String       @unique
  shopId            String       @db.Uuid
  invoiceId         String?      @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  transactionId     String?
  gatewayResponse   Json?
  paymentDate       DateTime     @default(now())
  notes             String?
  confirmedBy       String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@index([shopId])
  @@index([invoiceId])
  @@index([paymentStatus])
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  invoiceId String  @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
}

// ============================================================
// LEDGER
// ============================================================

model LedgerEntry {
  id             String              @id @default(uuid()) @db.Uuid
  shopId         String              @db.Uuid
  transactionType LedgerTransactionType
  referenceType  LedgerReferenceType
  referenceId    String
  debitAmount    Decimal             @default(0) @db.Decimal(12, 2)
  creditAmount   Decimal             @default(0) @db.Decimal(12, 2)
  runningBalance Decimal             @default(0) @db.Decimal(12, 2)
  transactionDate DateTime            @default(now())
  description    String?
  isReversal     Boolean             @default(false)
  reversedEntryId String?
  createdBy      String?             @db.Uuid
  createdAt      DateTime            @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@index([referenceType, referenceId])
  @@index([transactionDate])
}

// ============================================================
// OFFERS
// ============================================================

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  bannerUrl     String?
  discountType  DiscountType
  discountValue Decimal     @default(0) @db.Decimal(12, 2)
  buyQuantity   Int?
  getQuantity   Int?
  startDate     DateTime
  endDate       DateTime
  status        OfferStatus @default(SCHEDULED)
  views         Int         @default(0)
  redemptions   Int         @default(0)
  targetAllShops Boolean    @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products OfferProduct[]
  shops    OfferShop[]
  regions  OfferRegion[]

  @@index([status])
}

model OfferProduct {
  id        String @id @default(uuid()) @db.Uuid
  offerId   String @db.Uuid
  productId String @db.Uuid

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
}

model OfferShop {
  id      String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  shopId  String @db.Uuid

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([offerId, shopId])
}

model OfferRegion {
  id      String @id @default(uuid()) @db.Uuid
  offerId String @db.Uuid
  region  String
  shopId  String? @db.Uuid

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  shop  Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([offerId, region, shopId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  body        String
  data        Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
}

model NotificationPreference {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  type   NotificationType
  push   Boolean @default(true)
  sms    Boolean @default(false)
  email  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
}
